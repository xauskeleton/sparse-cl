# Cac repo vendor co .git rieng - khong track o day de tranh nested repo.
# Clone lai bang:
#   git clone https://github.com/scarlet0703/EWC-DR      upstream/EWC-DR
#   git clone https://github.com/SalehMomeni/AnaCP       upstream/AnaCP
upstream/EWC-DR/
upstream/AnaCP/

# Du lieu - khong bao gio commit
data/
*/data/
*/*/data/
*.tar.gz
*.zip

# Feature cache & ket qua chay
cache/
*/cache/
runs/
*/runs/

# logs/ ĐƯỢC track - đó là số liệu thô của mọi bảng trong docs/,
# tổng ~700 KB. Không có nó thì báo cáo không kiểm chứng lại được.
*.pt
*.pth
*.npy
*.npz
*.ckpt

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Claude Code - cai dat cuc bo cua tung may
.claude/settings.local.json

# Log chay - sinh lai duoc, khong track
log_*.txt
*/log_*.txt
*.rar
